{
  "expo": {
    "name": "BANEY",
    "slug": "baney-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "baney",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "do.baney.app"
    },
    "android": {
      "package": "do.baney.app",
      "adaptiveIcon": {
        "backgroundColor": "#2e320e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/image_mobile/baney_white.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2e320e"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
